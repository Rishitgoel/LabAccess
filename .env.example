# Copy to .env in the repository root. Never commit .env.
NODE_ENV=development
PORT=3001
MONGODB_URI=mongodb://127.0.0.1:27017/labaccess_dev
DB_CONNECT_TIMEOUT_MS=5000
# Phase 2 session configuration; replace before using authentication.
SESSION_SECRET=
SESSION_MAX_AGE_MS=28800000
APP_ORIGIN=http://127.0.0.1:5173
# Phase 2 guarded seed configuration; synthetic accounts only.
SEED_DEMO_PASSWORD=
