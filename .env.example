# Copy to .env in the repository root. Never commit .env.
NODE_ENV=development
PORT=3001
# Render automatically defaults to 0.0.0.0; local development stays loopback.
HOST=127.0.0.1
MONGODB_URI=mongodb://127.0.0.1:27017/labaccess_dev
DB_CONNECT_TIMEOUT_MS=5000
# Generate an independent random secret before using authentication.
SESSION_SECRET=
SESSION_MAX_AGE_MS=28800000
APP_ORIGIN=http://127.0.0.1:5173
# Use loopback for a trusted same-host TLS proxy; render on Render Web Services.
TRUST_PROXY=false
# Opt in only for a public demo database: grants access to both seeded demo roles.
DEMO_LOGIN_ENABLED=false
# Guarded seed configuration; synthetic accounts only.
SEED_DEMO_PASSWORD=
